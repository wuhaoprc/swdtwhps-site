# 长缓存给不常变的库与图片；入口 html 与站点自有 JS 每次必回源校验（发布即生效）
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800

/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

# Cloudflare Pages 默认给非 html 资源 max-age=14400，且会洗掉我们设的 no-cache。
# 先用 ! 删除默认头，再写入 no-cache —— 否则指令会被丢掉。
# 新增源码目录时记得同步加一行。
/src/*
  ! Cache-Control
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/utils/*
  ! Cache-Control
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/*.js
  ! Cache-Control
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
