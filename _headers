# ---------- 全站安全响应头（含根路径 /） ----------
/*
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; worker-src 'self' blob:; manifest-src 'self'

# ---------- 官网（根路径） ----------
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()

/assets/img/*
  Cache-Control: public, max-age=604800

# ---------- 3D 演示（/3d/） ----------
/3d/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

/3d/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/3d/assets/*
  Cache-Control: public, max-age=604800

/3d/src/*
  ! Cache-Control
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/3d/utils/*
  ! Cache-Control
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/3d/*.js
  ! Cache-Control
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
